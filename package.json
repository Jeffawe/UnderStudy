{
  "name": "@jeffawe/understudy",
  "version": "0.2.1",
  "description": "End-to-end tests for your own web apps: record a flow once, and Understudy remembers it, replays it, notices when the app changes, and runs goals you describe in words — on its own or as an MCP server for AI agents.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeffawe/UnderStudy.git"
  },
  "homepage": "https://understudy.jeffawe.dev",
  "bugs": {
    "url": "https://github.com/Jeffawe/UnderStudy/issues"
  },
  "keywords": [
    "e2e",
    "testing",
    "playwright",
    "mcp",
    "agent",
    "mongodb",
    "vector-search",
    "browser-recording"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "understudy": "dist/entry/cli.js",
    "understudy-mcp": "dist/entry/mcp.js"
  },
  "files": [
    "dist",
    "extension",
    "build/extension/firefox",
    "REASONER.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run extension:package && npm run build",
    "understudy": "tsx src/entry/cli.ts",
    "mcp": "tsx src/entry/mcp.ts",
    "extension:build": "tsx scripts/build-extension.ts",
    "vendor:accname": "node scripts/vendor-accname.mjs",
    "prepublishOnly": "npm run typecheck",
    "extension:package": "npm run extension:build && node scripts/package-extension.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dom-accessibility-api": "^0.7.1",
    "dotenv": "^17.2.3",
    "mongodb": "^7.9.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.20.6"
  }
}
