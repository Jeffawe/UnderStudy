{
  "name": "understudy",
  "version": "0.1.0",
  "description": "Learns a web app from browser recordings and keeps that knowledge as searchable memory in MongoDB, so you can say \"test login\" and it works.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "understudy": "./dist/entry/cli.js",
    "understudy-mcp": "./dist/entry/mcp.js"
  },
  "files": [
    "dist",
    "extension"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "understudy": "tsx src/entry/cli.ts",
    "vendor:accname": "node scripts/vendor-accname.mjs",
    "hair-loss:book": "tsx .understudy/explorations/hair-loss-book.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "mcp": "tsx src/entry/mcp.ts",
    "extension:build": "tsx scripts/build-extension.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dom-accessibility-api": "^0.7.1",
    "dotenv": "^17.2.3",
    "mongodb": "^7.9.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.20.6"
  }
}
