# Copy to .env and fill in. .env is gitignored; this file is not.

# CockroachDB Cloud — get from: ccloud cluster connection-string <cluster>
CRDB_URL="postgresql://<user>:<password>@<cluster>.<region>.cockroachlabs.cloud:26257/understudy?sslmode=verify-full"

# Local dev target — cockroach start-single-node, insecure
CRDB_LOCAL_URL="postgresql://root@localhost:26257/understudy?sslmode=disable"

# Which store the CLI talks to by default: local | cloud
UNDERSTUDY_TARGET=local

# Embedder — MUST match the value recorded in the meta table.
# Changing this invalidates every stored vector, and the meta guard will refuse
# to connect rather than let you mix two vector spaces. The only other value,
# amazon.titan-embed-text-v2:0, is therefore for a FRESH database only.
EMBEDDER_ID=mxbai-embed-large

# --- Mode A (hosted): distiller + reasoner run on Bedrock -------------------
# Mode B (attached to an agent session via MCP) needs none of this.
# Verify the whole path with: npm run bedrock:check

AWS_REGION=us-east-1

# Credentials are resolved by the standard AWS chain, so any ONE of these works:
#   · the two keys below
#   · AWS_PROFILE=<name> for a named profile or SSO
#   · an instance role, when deployed
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# Bedrock model ids take an `anthropic.` prefix — a first-party id 404s.
# Both models need access granted in the Bedrock console, in AWS_REGION.
# DISTILLER_MODEL=anthropic.claude-haiku-4-5
# REASONER_MODEL=anthropic.claude-sonnet-5
