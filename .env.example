# Copy to .env and fill in. .env is gitignored; this file is not.

# CockroachDB Cloud — get from: ccloud cluster connection-string <cluster>
CRDB_URL="postgresql://<user>:<password>@<cluster>.<region>.cockroachlabs.cloud:26257/understudy?sslmode=verify-full"

# Local dev target — cockroach start-single-node, insecure
CRDB_LOCAL_URL="postgresql://root@localhost:26257/understudy?sslmode=disable"

# Which store the CLI talks to by default: local | cloud
UNDERSTUDY_TARGET=local

# Embedder — MUST match the value recorded in the meta table.
# Changing this invalidates every stored vector, and the meta guard will refuse
# to connect rather than let you mix two vector spaces. The only other value,
# amazon.titan-embed-text-v2:0, is therefore for a FRESH database only.
EMBEDDER_ID=mxbai-embed-large

# --- Mode A (hosted): distiller + reasoner run on Bedrock -------------------
# Mode B (attached to an agent session via MCP) needs none of this.
# Verify the whole path with: npm run bedrock:check

AWS_REGION=us-east-1

# Credentials are resolved by the standard AWS chain, so any ONE of these works:
#   · the two keys below
#   · AWS_PROFILE=<name> for a named profile or SSO
#   · an instance role, when deployed
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# Bedrock model ids take an `anthropic.` prefix — a first-party id 404s.
# Both models need access granted in the Bedrock console, in AWS_REGION.
# DISTILLER_MODEL=anthropic.claude-haiku-4-5
# REASONER_MODEL=anthropic.claude-sonnet-5

# --- Run budgets: when a run stops trying and asks you to record ------------
# All optional; the defaults below are what apply when unset.
#
# Once ANY of these is spent, the next thing that would have been a question
# becomes a `needs_capture` request instead: the run parks its browser state,
# hands you a `understudy record --seed-session … --seed-url …` command, and
# waits for you to send back the hash it prints.

# Tries per step before the step counts as stuck. 1 = today's behaviour (no
# retries). Only ADDRESSING failures are retried — once an action has gone out,
# retrying it would submit twice, so it never does.
# UNDERSTUDY_MAX_STEP_ATTEMPTS=1

# Reasoner round trips of any kind, including the opening decompose.
# UNDERSTUDY_MAX_DECISIONS=25

# Wall clock for the whole run.
# UNDERSTUDY_MAX_RUN_MINUTES=30

# A run idle this long on an unanswered question is marked 'abandoned' and its
# question expired, the next time any run opens on the same app.
# UNDERSTUDY_ABANDON_AFTER_HOURS=24

# Estimated tokens exchanged with the reasoner.
#
# NOTE WHAT THIS CAN AND CANNOT SEE. In Mode B the executor calls no model —
# YOU are the reasoner — so Understudy cannot read your token usage. It meters
# the payloads it hands you and the answers that come back (~4 chars/token,
# plus a surcharge per image it asks you to open, since a visual diff is a few
# hundred characters of paths and then three PNGs). That estimate under-counts
# your own deliberation, so it is tuned to trip early.
#
# You can pass your real figure on any `understudy_resume_run` call as
# `usage: { totalTokens }`. It is folded in with max(), so a self-report can
# only make the budget trip SOONER, never later.
# UNDERSTUDY_MAX_DECISION_TOKENS=120000
