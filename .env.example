# Copy to .env and fill in. .env is gitignored; this file is not.

# --- MongoDB ------------------------------------------------------------------
# Local Community Edition, or your Atlas cluster — same driver, same queries.
#   local:  mongodb://localhost:27017/?directConnection=true
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI="mongodb://localhost:27017/?directConnection=true"
# Database name inside the cluster. Tests use their own and empty it afterwards.
# MONGODB_DB=understudy

# --- Embedding model (optional) ----------------------------------------------
# Any OpenAI-style /v1/embeddings endpoint. Leave URL and MODEL unset to run
# with no model: search then matches names only. One model per database —
# switching later needs `understudy reembed`.
#   Voyage (default):  https://api.voyageai.com/v1/embeddings   voyage-4-lite   1024
#   OpenAI:            https://api.openai.com/v1/embeddings     text-embedding-3-small  1536
#   Ollama (offline):  http://localhost:11434/v1/embeddings     mxbai-embed-large      1024
# EMBED_URL=https://api.voyageai.com/v1/embeddings
# EMBED_MODEL=voyage-4-lite
# EMBED_KEY=
# EMBED_DIMS=1024

# --- Login values (optional) ---------------------------------------------------
# Recordings never store passwords: a password field is kept as a reference
# like SECRET.password, and its value is read from UNDERSTUDY_SECRET_PASSWORD.
# UNDERSTUDY_SECRET_PASSWORD=

# --- Where local files go (optional; defaults under .understudy/) ------------
# UNDERSTUDY_RECORDINGS_DIR=
# UNDERSTUDY_SESSIONS_DIR=
# UNDERSTUDY_FIXTURES_DIR=
# UNDERSTUDY_SHOTS_DIR=
