node_modules/
dist/
*.tsbuildinfo

# Secrets — connection strings, AWS creds, app credentials
.env
.env.*
!.env.example

# Local artifacts: traces are ~40MB each and never leave this machine
.understudy/tmp/
.understudy/traces/
.understudy/shots/

# Raw recordings. Credentials are redacted to value_refs at capture, but the
# events still carry whatever was typed into ordinary fields — on a real app
# that is customer data. Opt in per recording by force-adding a fixture.
.understudy/recordings/

# Exploration specs written up after driving an unknown flow by hand. Same
# reasoning as recordings: the steps carry whatever was typed into a real form,
# and the fixtures beside them can be patient photos.
.understudy/explorations/

# Saved browser sessions, keyed by a hash of the credentials that made them.
# storageState holds live cookies and tokens — a credential in every meaningful
# sense, and a shorter-lived one than a password but no less usable. Written
# 0600 and never mirrored to the database for the same reason.
.understudy/sessions/

# Distiller cache, keyed by recording hash — regenerable, but expensive to lose
.understudy/cache/
.understudy/distilled/

# Pending distillation requests — ephemeral scratch, regenerated on demand
.understudy/requests/

# Local cockroach data dir
cockroach-data/

# Playwright
playwright/.auth/
test-results/
playwright-report/

# Cloudflare Tunnel credentials
.cloudflared/
*.tunnel.json

.DS_Store

# Playwright MCP scratch output: page snapshots, console logs, screenshots
.playwright-mcp/

# Internal docs. The repo shows README.md and REASONER.md — what Understudy is
# and how to drive it. Everything below is a working document written for
# whoever is building it, and carries things a visitor should not have: Oracle
# public IPs and SSH details, the CockroachDB org id, cluster host and SQL user,
# and absolute paths into a laptop nobody else has. Keep them local.
PLAN.md
STATUS.md
STATUS-HISTORY.md
BUILDING.md
CLAUDE.md

# Uploaded files copied in by the recorder. Ignored for the same reason
# recordings are: a captured upload can be a photo of someone's ID.
.understudy/fixtures/
